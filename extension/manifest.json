{
  "manifest_version": 3,
  "name": "RichPresence for Netflix & Hulu",
  "version": "1.0.0",
  "description": "Shows the show and episode you're watching on Netflix and Hulu on your Discord status, through the RichPresence app on your PC.",
  "icons": { "48": "icon48.png", "128": "icon128.png" },
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://www.netflix.com/*"], "js": ["common.js", "netflix.js"], "run_at": "document_idle" },
    { "matches": ["https://www.hulu.com/*"], "js": ["common.js", "hulu.js"], "run_at": "document_idle" }
  ],
  "action": { "default_popup": "popup.html", "default_title": "RichPresence" }
}
