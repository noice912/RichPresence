{
  "manifest_version": 3,
  "name": "RichPresence - what you're watching",
  "version": "1.1.0",
  "description": "Shows the show and episode you're watching on Netflix, Hulu, Disney+, Prime Video, Max, Crunchyroll and more on your Discord status, through the RichPresence app on your PC.",
  "icons": { "48": "icon48.png", "128": "icon128.png" },
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*",
        "https://www.hulu.com/*",
        "https://*.disneyplus.com/*",
        "https://www.primevideo.com/*",
        "https://www.amazon.com/*", "https://www.amazon.ca/*", "https://www.amazon.co.uk/*", "https://www.amazon.de/*",
        "https://www.amazon.fr/*", "https://www.amazon.it/*", "https://www.amazon.es/*", "https://www.amazon.co.jp/*",
        "https://www.amazon.in/*", "https://www.amazon.com.au/*", "https://www.amazon.com.br/*", "https://www.amazon.com.mx/*",
        "https://play.max.com/*", "https://play.hbomax.com/*",
        "https://www.crunchyroll.com/*",
        "https://www.paramountplus.com/*",
        "https://www.peacocktv.com/*",
        "https://tv.apple.com/*",
        "https://app.plex.tv/*",
        "https://www.youtube.com/*", "https://m.youtube.com/*",
        "https://www.twitch.tv/*", "https://m.twitch.tv/*"
      ],
      "js": ["common.js", "sites.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://static.crunchyroll.com/*"],
      "js": ["frame.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "RichPresence" }
}
